! Template: {{RUN_HOURS}} and the start/end fields ({{SY}} year, {{SM}} month, {{SD}} day,
! {{SH}} hour, and the E-prefixed equivalents) are filled in by wrf.py.
&time_control
 run_days = 0,
 run_hours = {{RUN_HOURS}},
 run_minutes = 0,
 run_seconds = 0,
 start_year = {{SY}}, {{SY}},
 start_month = {{SM}}, {{SM}},
 start_day = {{SD}}, {{SD}},
 start_hour = {{SH}}, {{SH}},
 end_year = {{EY}}, {{EY}},
 end_month = {{EM}}, {{EM}},
 end_day = {{ED}}, {{ED}},
 end_hour = {{EH}}, {{EH}},
 interval_seconds = 10800,
 input_from_file = .true., .true.,
 history_interval = 60, 60,
 frames_per_outfile = 1000, 1000,
 restart = .false.,
 io_form_history = 2,
 io_form_input = 2,
 io_form_boundary = 2,
/

&domains
 time_step = 60,
 max_dom = 2,
 e_we = 100, 100,
 e_sn = 100, 100,
 e_vert = 40, 40,
 dx = 12000, 4000,
 dy = 12000, 4000,
 grid_id = 1, 2,
 parent_id = 0, 1,
 i_parent_start = 1, 34,
 j_parent_start = 1, 34,
 parent_grid_ratio = 1, 3,
 parent_time_step_ratio = 1, 3,
 feedback = 0,
 num_metgrid_levels = 34,
 num_metgrid_soil_levels = 4,
/

&physics
 mp_physics = 6, 6,
 ra_lw_physics = 4, 4,
 ra_sw_physics = 4, 4,
 radt = 12, 12,
 sf_sfclay_physics = 1, 1,
 sf_surface_physics = 2, 2,
 bl_pbl_physics = 1, 1,
 bldt = 0, 0,
 cu_physics = 1, 0,
 cudt = 5, 5,
/

&dynamics
 w_damping = 1,
 diff_opt = 1, 1,
 km_opt = 4, 4,
 non_hydrostatic = .true., .true.,
/

&bdy_control
 spec_bdy_width = 5,
 specified = .true.,
/
