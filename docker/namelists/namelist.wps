! Template: {{START}} and {{END}} are WPS date strings, e.g. 2026-10-03_00:00:00
&share
 wrf_core = 'ARW',
 max_dom = 2,
 start_date = '{{START}}', '{{START}}',
 end_date   = '{{END}}', '{{END}}',
 interval_seconds = 10800,
 io_form_geogrid = 2,
/

&geogrid
 parent_id         = 1, 1,
 parent_grid_ratio = 1, 3,
 i_parent_start    = 1, 34,
 j_parent_start    = 1, 34,
 e_we              = 100, 100,
 e_sn              = 100, 100,
 geog_data_res     = 'default', 'default',
 dx = 12000,
 dy = 12000,
 map_proj = 'lambert',
 ref_lat   = -36.7584,
 ref_lon   = 146.9658,
 truelat1  = -30.0,
 truelat2  = -60.0,
 stand_lon = 146.9658,
 geog_data_path = '/data/WPS_GEOG',
/

&ungrib
 out_format = 'WPS',
 prefix = 'GFS',
/

&metgrid
 fg_name = 'GFS',
 io_form_metgrid = 2,
/
