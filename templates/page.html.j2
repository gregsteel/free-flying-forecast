{% macro arrow(cls, rot) -%}<span class="dir {{ cls }}" title="{{ dir_titles[cls] }}" aria-hidden="true"><svg viewBox="0 0 20 20" width="100%" height="100%" aria-hidden="true" focusable="false" style="transform:rotate({{ rot }}deg)"><path d="M10 18.5 3.5 3.5h13z" fill="currentColor"/></svg></span>{%- endmacro %}
<!doctype html>
<html lang="en-AU">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Free Flying Forecast: {{ site.name }}</title>
<meta name="description" content="Simple soaring forecast for paraglider and hang glider pilots at {{ site.name }}.">
<style>
:root{--bg:#f7f8fa;--fg:#1d2430;--muted:#5b6575;--card:#fff;--line:#d9dee6;
--good:#1f7a3d;--good-bg:#e3f4e8;--ok:#0f6e6a;--ok-bg:#d7f2ef;--strong:#6d28d9;--strong-bg:#ece3ff;--poor:#8a6d00;--poor-bg:#fff4cc;
--turbulent:#a14a00;--turbulent-bg:#ffe5cc;--dangerous:#a3121a;--dangerous-bg:#fde0e1;--link:#0b5cad}
@media (prefers-color-scheme:dark){:root{--bg:#12161c;--fg:#e6eaf0;--muted:#9aa5b5;--card:#1b212b;--line:#2d3644;
--good:#6fd08c;--good-bg:#17331f;--ok:#6fd6cf;--ok-bg:#10312f;--strong:#c9a8ff;--strong-bg:#2b1d49;--poor:#e6c34d;--poor-bg:#3a3210;
--turbulent:#ffab5e;--turbulent-bg:#3d2812;--dangerous:#ff8a90;--dangerous-bg:#401519;--link:#7db8ff}}
*{box-sizing:border-box}
body{margin:0;background:var(--bg);color:var(--fg);font:16px/1.45 system-ui,sans-serif}
main{max-width:56rem;margin:0 auto;padding:1rem}
h1{font-size:1.5rem;margin:.2rem 0}h2{font-size:1.2rem;margin:1.6rem 0 .6rem}h3{font-size:1rem;margin:1rem 0 .4rem}
a{color:var(--link)}.muted{color:var(--muted);font-size:.9rem}
.banner{background:var(--poor-bg);color:var(--poor);border:1px solid var(--poor);border-radius:8px;padding:.6rem .8rem;margin:.8rem 0}
.grid{display:grid;gap:.6rem;grid-template-columns:repeat(auto-fit,minmax(15rem,1fr))}
.pill.ok{border-color:var(--ok)}.pill.good{border-color:var(--good)}.pill.strong{border-color:var(--strong)}.pill.poor{border-color:var(--poor)}
.pill.turbulent{border-color:var(--turbulent)}.pill.dangerous{border-color:var(--dangerous)}
/* Glider choice: every value is rendered for both gliders (class g-pg / g-hg) and CSS shows only
   the chosen one. A block or cell carries both grades as variables; the chosen glider's is used. */
.pg-ok{--pgc:var(--ok);--pgb:var(--ok-bg)}.pg-strong{--pgc:var(--strong);--pgb:var(--strong-bg)}
.pg-good{--pgc:var(--good);--pgb:var(--good-bg)}.pg-poor{--pgc:var(--poor);--pgb:var(--poor-bg)}
.pg-turbulent{--pgc:var(--turbulent);--pgb:var(--turbulent-bg)}.pg-dangerous{--pgc:var(--dangerous);--pgb:var(--dangerous-bg)}
.hg-ok{--hgc:var(--ok);--hgb:var(--ok-bg)}.hg-strong{--hgc:var(--strong);--hgb:var(--strong-bg)}
.hg-good{--hgc:var(--good);--hgb:var(--good-bg)}.hg-poor{--hgc:var(--poor);--hgb:var(--poor-bg)}
.hg-turbulent{--hgc:var(--turbulent);--hgb:var(--turbulent-bg)}.hg-dangerous{--hgc:var(--dangerous);--hgb:var(--dangerous-bg)}
body:has(#gl-hg:checked) .g-pg{display:none}
body:not(:has(#gl-hg:checked)) .g-hg{display:none}
.pill{white-space:nowrap;display:inline-block;border:2px solid;border-radius:999px;padding:0 .6rem;font-weight:600}
.pill.ok{background:var(--ok-bg);color:var(--ok)}.pill.strong{background:var(--strong-bg);color:var(--strong)}
.pill.good{background:var(--good-bg);color:var(--good)}.pill.poor{background:var(--poor-bg);color:var(--poor)}
.pill.turbulent{background:var(--turbulent-bg);color:var(--turbulent)}.pill.dangerous{background:var(--dangerous-bg);color:var(--dangerous)}
.time{font-weight:700;font-size:1.1rem}
dl{margin:.4rem 0;display:grid;grid-template-columns:auto 1fr;gap:.1rem .8rem}dt{color:var(--muted)}dd{margin:0}
ul.reasons{margin:.4rem 0 0;padding-left:1.1rem;font-size:.9rem;color:var(--muted)}
img.history{display:block;min-height:6rem;width:100%;max-width:780px;height:auto;border:1px solid var(--line);border-radius:8px;background:#fff}
.tile{background:var(--card);border:1px solid var(--line);border-radius:8px;padding:.7rem .9rem}
.tile-main{display:flex;align-items:center;gap:.8rem}.tile-icon{font-size:2.6rem;line-height:1}
.tile-text{font-weight:600}.tile-temp{font-size:1.8rem;font-weight:700}

/* Unit selection: every value is rendered in all units; CSS shows only the chosen one.
   Defaults: knots, metres, Celsius. Works without JavaScript. */
.u{display:none}
.s-kts,.a-m,.t-c{display:inline}
{% for u in speed_units %}body:has(#sp-{{ u }}:checked) .u.s-{{ u }}{display:inline}
{% if not loop.first %}body:has(#sp-{{ u }}:checked) .u.s-{{ speed_units[0] }}{display:none}
{% endif %}{% endfor %}{% for u in alt_units %}{% if not loop.first %}body:has(#al-{{ u }}:checked) .u.a-{{ u }}{display:inline}
body:has(#al-{{ u }}:checked) .u.a-{{ alt_units[0] }}{display:none}
{% endif %}{% endfor %}{% for u in temp_units %}{% if not loop.first %}body:has(#tp-{{ u }}:checked) .u.t-{{ u }}{display:inline}
body:has(#tp-{{ u }}:checked) .u.t-{{ temp_units[0] }}{display:none}
{% endif %}{% endfor %}
/* The title bar, settings, update time and alert stay pinned; only the rest of the page scrolls. */
html{scroll-padding-top:calc(var(--hdr,6rem) + .75rem)}
.sticky{position:sticky;top:0;z-index:30;background:var(--bg);margin:0 -1rem;padding:.6rem 1rem .9rem;border-bottom:1px solid var(--line);box-shadow:0 8px 8px -8px rgba(0,0,0,.55)}
.sticky h1{margin:.1rem 0}
.sticky>.muted{margin:.25rem 0 0;font-size:.85rem}
.sticky .banner{margin:.4rem 0 0;padding:.35rem .6rem;font-size:.9rem}
@media (max-width:44rem){.sticky h1{font-size:1.05rem;line-height:1.2}}
/* Weather station period: every period is in the page but only the chosen one is shown, so only that chart is fetched. */
.st{display:none}
{% if weather_tabs|length > 1 %}.wx{display:none}
{% for t in weather_tabs %}body:has(#wx-{{ t.id }}:checked) span.wx-{{ t.id }}{display:inline}
body:has(#wx-{{ t.id }}:checked) div.wx-{{ t.id }}{display:block}
{% endfor %}{% endif %}/* The club's gauge page, shrunk and cropped to just its circle (the page lays out at 500 px wide: measured, the circle's outer ring runs from x 40 to 459 and y 154 to 573, so 420 px square at 40, 154; 168 px is 420 at .4). */
.gaugewrap{box-sizing:content-box;position:relative;width:168px;height:168px;overflow:hidden;border-radius:50%;margin:0 auto .6rem;background:#fff;border:1px solid var(--line)}
.gauge{position:absolute;left:0;top:0;border:0;max-width:none;transform-origin:0 0;transform:scale(.4) translate(-40px,-154px)}
.fine{margin:.3rem 0 .2rem;font-size:.78rem}
section[aria-label="Weather station"] .periods{margin:.6rem 0 0}
.tabnote{margin:.5rem 0 0;font-size:.9rem;font-weight:600}.tablink{margin:.4rem 0 0;font-size:.9rem}
{% for c in station_charts %}body:has(#st-{{ c.id }}:checked) span.st-{{ c.id }},body:has(#st-{{ c.id }}:checked) a.st-{{ c.id }}{display:inline}
body:has(#st-{{ c.id }}:checked) p.st-{{ c.id }}{display:block}
{% endfor %}.periods{display:flex;flex-wrap:wrap;border:0;margin:0 0 .6rem;padding:0;position:relative}
.periods legend{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0)}
.periods input{position:absolute;opacity:0;pointer-events:none}
.periods label{padding:.35rem .75rem;border:1px solid var(--line);border-left-width:0;cursor:pointer;font-size:.9rem;font-weight:600;background:var(--card)}
.periods label:first-of-type{border-left-width:1px;border-radius:8px 0 0 8px}.periods label:last-of-type{border-radius:0 8px 8px 0}
.periods input:checked+label{background:var(--link);border-color:var(--link);color:var(--card)}
.periods input:focus-visible+label{outline:3px solid var(--link);outline-offset:2px;position:relative}
.bar{display:flex;align-items:center;justify-content:space-between;gap:1rem;position:relative}
.bar h1{margin:.2rem 0}
.bar-right{display:flex;align-items:center;gap:.6rem;flex:none}
.glider{display:flex;border:0;margin:0;padding:0;position:relative}
.glider legend{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0)}
.glider label{display:flex;align-items:center;height:2.8rem;padding:0 .85rem;font-weight:700;border-radius:0}
.glider label[for=gl-pg]{border-radius:8px 0 0 8px}.glider label[for=gl-hg]{border-radius:0 8px 8px 0;border-left-width:0}
.menu{position:relative;flex:none}
.menu>summary{list-style:none;cursor:pointer;display:flex;align-items:center;justify-content:center;width:2.8rem;height:2.8rem;border:1px solid var(--line);border-radius:8px;background:var(--card);color:var(--fg)}
.menu>summary::-webkit-details-marker{display:none}
.menu>summary:focus-visible{outline:3px solid var(--link);outline-offset:2px}
.menu[open]>summary{background:var(--link);border-color:var(--link);color:var(--card)}
.panel{position:absolute;right:0;top:3.3rem;z-index:20;width:min(19rem,calc(100vw - 2rem));background:var(--card);border:1px solid var(--line);border-radius:10px;padding:.2rem .9rem .8rem;box-shadow:0 8px 24px rgba(0,0,0,.35)}
.panel h2{margin:.7rem 0 .4rem;font-size:1.05rem}
.units{display:flex;flex-direction:column;gap:.7rem;position:relative}
.units fieldset{border:0;margin:0;padding:0;display:flex;align-items:center;gap:.3rem}
.units legend{float:left;width:4.2rem;padding:0;color:var(--muted);font-size:.9rem}
.units input,.glider input{position:absolute;opacity:0;pointer-events:none}
.units label,.glider label{padding:.3rem .8rem;border:1px solid var(--line);border-radius:6px;cursor:pointer;font-size:.95rem}
.units input:checked+label,.glider input:checked+label{background:var(--link);border-color:var(--link);color:var(--card);font-weight:600}
.units input:focus-visible+label,.glider input:focus-visible+label{outline:3px solid var(--link);outline-offset:2px}

/* Days as rows: heading at the left, one column per hour ({{ first_hour }} to {{ last_hour }}). */
details.day{--lw:3.4rem;background:var(--card);border:1px solid var(--line);border-radius:8px;margin:.5rem 0;overflow:hidden}
details.day>summary{list-style:none;cursor:pointer;display:grid;grid-template-columns:var(--lw) repeat({{ slot_count }},minmax(0,1fr));gap:.1rem;align-items:stretch;padding:.3rem}
details.day>summary::-webkit-details-marker{display:none}
details.day>summary:focus-visible{outline:3px solid var(--link);outline-offset:-3px}
.daylabel{display:flex;flex-direction:column;justify-content:center;font-size:.8rem;line-height:1.25}
.daylabel strong{font-size:1rem}
.daylabel::after{content:"\25B8";color:var(--muted);font-size:1.1rem;line-height:1;margin-top:.15rem;transition:transform .15s}
details[open]>summary .daylabel::after{transform:rotate(90deg)}
.cell{display:flex;flex-direction:column;gap:.1rem;padding:.3rem .15rem;border-radius:6px;border-top:4px solid var(--line);font-size:.78rem;line-height:1.25;min-width:0;text-align:center}
.cell.empty{border-top-color:transparent}
.cell{border-top-color:var(--pgc,transparent);background:var(--pgb,transparent)}
body:has(#gl-hg:checked) .cell{border-top-color:var(--hgc,transparent);background:var(--hgb,transparent)}
.ctime{color:var(--muted)}.cht{font-weight:600}.chg{color:var(--muted)}
.clw{font-weight:600;white-space:nowrap;font-size:.72rem;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:.1rem}
.cicon{font-size:1.7rem;line-height:1.15}
/* The hourly cells are narrow (nine across): small type, bare numbers, units come from the settings. */
details.day .cell{padding:.25rem .05rem;font-size:.62rem;gap:.05rem}
details.day .cicon{font-size:1.15rem}
details.day .clw{font-size:.6rem;gap:.05rem}
details.day .dir{width:1.7em;height:1.7em;padding:.15em}
.dtscroll{overflow-x:auto}
/* Direction arrow: coloured by where the wind comes from, on a white circle so it reads in dark mode too. */
.dir{display:inline-flex;align-items:center;justify-content:center;width:1.8em;height:1.8em;padding:.2em;box-sizing:border-box;border-radius:50%;background:#fff;flex:none}
.dir svg{display:block;overflow:visible}
.dir.ok{color:#17803d}.dir.marginal{color:#b45309}.dir.off{color:#c62828}
.sr{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0);white-space:nowrap}
/* Day details: one table. Row headings sit once in the left column under the date, and the four
   times are columns that line up with the header row above. */
.detail{padding:.1rem .1rem .7rem;border-top:1px solid var(--line)}
table.dt{width:100%;min-width:{{ slot_count * 3.6 + 5.5 }}rem;table-layout:fixed;border-collapse:separate;border-spacing:.1rem 0}
table.dt col.dt-first{width:var(--lw)}
table.dt th[scope=row]{position:sticky;left:0;z-index:1;background:var(--card);text-align:left;font-weight:400;color:var(--muted);font-size:.74rem;line-height:1.25;padding:.4rem .25rem .4rem .3rem;vertical-align:top;border-top:1px solid var(--line)}
table.dt td{padding:.4rem .1rem;text-align:center;font-weight:600;font-size:.76rem;line-height:1.3;vertical-align:top;border-top:1px solid var(--line);overflow-wrap:anywhere}
table.dt td .clw{justify-content:center}
table.dt thead th{font-weight:600;padding:.3rem .1rem .35rem;border-top:4px solid var(--pgc,transparent);background:var(--pgb,transparent);border-radius:6px 6px 0 0}
body:has(#gl-hg:checked) table.dt thead th{border-top-color:var(--hgc,transparent);background:var(--hgb,transparent)}
table.dt thead th.empty{border-top-color:transparent;background:none}
.nb{white-space:nowrap}
table.dt .pill{white-space:normal;border:0;background:none;padding:0;font-size:.74rem}
table.dt .ic{display:none}
.whygrid{display:block;padding:0 .3rem}
details.whyd{margin-top:.3rem;border-top:1px solid var(--line)}
details.whyd>summary{cursor:pointer;font-size:.8rem;color:var(--muted);padding:.4rem .3rem}
details.whyd>summary:focus-visible{outline:3px solid var(--link);outline-offset:-3px}
.whygrid ul.reasons{margin:0;padding-left:1rem;font-size:.76rem}
.whytime{display:block;font-size:.8rem;margin-top:.5rem}
.outlook{display:grid;gap:.2rem;grid-template-columns:repeat({{ outlook_cols }},minmax(0,1fr))}
.cwet{font-size:.72rem;font-weight:600;color:var(--poor)}
@media (max-width:44rem){
  .whygrid ul.reasons{font-size:.8rem}
  /* On a narrow screen show every other hour (10, 12, 14, 16, 18): nine columns would be too small to read. */
  details.day{--lw:5rem}
  details.day>summary{grid-template-columns:var(--lw) repeat({{ (slot_count + 1) // 2 }},minmax(0,1fr))}
  details.day>summary>.cell:nth-child(2n+3){display:none}
  table.dt{min-width:0}
  table.dt tr>:nth-child(2n+3),table.dt col:nth-child(2n+3){display:none}
  .whygrid>.why:nth-child(even){display:none}
}
@media (min-width:44rem){
  details.day{--lw:9.5rem}
  table.dt{min-width:0}
  table.dt th[scope=row]{font-size:.85rem}table.dt td{font-size:.9rem}
  table.dt thead th{padding-top:.4rem}
  table.dt .pill{font-size:.85rem;border:1px solid;padding:0 .5rem}table.dt .pill.ok{background:var(--ok-bg)}table.dt .pill.strong{background:var(--strong-bg)}table.dt .pill.good{background:var(--good-bg)}table.dt .pill.poor{background:var(--poor-bg)}
  table.dt .pill.turbulent{background:var(--turbulent-bg)}table.dt .pill.dangerous{background:var(--dangerous-bg)}table.dt .ic{display:inline}
  .outlook .cell{font-size:.9rem}.outlook .cicon{font-size:2rem}.outlook .clw{font-size:.9rem;flex-direction:row;gap:.3rem}
  details.day .cell{font-size:.8rem}details.day .cicon{font-size:1.5rem}details.day .clw{font-size:.75rem}
  table.dt td,table.dt th[scope=row]{font-size:.8rem}table.dt td{font-size:.82rem}
}
.top{display:grid;gap:0 1.2rem;grid-template-columns:minmax(0,1fr)}
@media (min-width:44rem){.top{grid-template-columns:repeat(2,minmax(0,1fr));align-items:start}.top>#now{order:2}}  /* wide screens: the station (gauge and chart) on the left, the weather on the right; phones keep the weather first */
img.history{max-width:440px}
.tile{max-width:none}
table.today{width:100%;border-collapse:collapse;margin:.6rem 0 0;font-size:.85rem}
table.today th{font-weight:500;color:var(--muted);text-align:left;padding:.15rem .2rem;border-bottom:1px solid var(--line)}
table.today td{padding:.2rem;border-bottom:1px solid var(--line);vertical-align:middle}
table.today tr.past{opacity:.5}table.today tr.nowrow{background:var(--poor-bg)}
a.pill,a.cicon{text-decoration:none}
a.cicon{display:block;color:inherit;border-radius:6px}
a.cicon:hover{transform:scale(1.12)}a.cicon:focus-visible,a.pill:focus-visible{outline:3px solid var(--link);outline-offset:2px}
a.pill:hover{filter:brightness(1.15)}
details.guide{margin:1.4rem 0 0}
details.guide>summary{list-style:none;cursor:pointer;display:flex;align-items:baseline;gap:.8rem;flex-wrap:wrap;padding:.1rem 0}
details.guide>summary::-webkit-details-marker{display:none}
details.guide>summary h2{display:inline;margin:0}
details.guide>summary::before{content:"\25B8";font-size:1.2rem;transition:transform .15s}
details.guide[open]>summary::before{transform:rotate(90deg)}
details.guide>summary:focus-visible{outline:3px solid var(--link);outline-offset:3px;border-radius:6px}
.guide li{scroll-margin-top:1rem;border-radius:8px;padding:.15rem .3rem}
.guide li.hl{outline:3px solid var(--link);outline-offset:2px;background:var(--card)}
footer{margin:2rem 0 1rem;padding-top:1rem;border-top:1px solid var(--line)}
</style>
</head>
<body>
<main>
<div class="sticky" id="sticky">
<header class="bar">
<h1>Free Flying Forecast: {{ site.name }}</h1>
<div class="bar-right">
<fieldset class="glider"><legend class="sr">Glider type</legend>
<input type="radio" name="gl" id="gl-pg" checked><label for="gl-pg" title="Paraglider">PG</label>
<input type="radio" name="gl" id="gl-hg"><label for="gl-hg" title="Hang glider">HG</label></fieldset>
<details class="menu" id="menu">
<summary aria-label="Settings" title="Settings"><svg viewBox="0 0 24 24" width="26" height="26" aria-hidden="true" focusable="false"><path d="M3 6h18M3 12h18M3 18h18" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" fill="none"/></svg></summary>
<div class="panel" role="group" aria-label="Settings">
<h2>Settings</h2>
<form class="units" aria-label="Display units" onsubmit="return false">
<fieldset><legend>Wind</legend>
<input type="radio" name="sp" id="sp-kts" checked><label for="sp-kts">kts</label>
<input type="radio" name="sp" id="sp-kph"><label for="sp-kph">km/h</label></fieldset>
<fieldset><legend>Height</legend>
<input type="radio" name="al" id="al-m" checked><label for="al-m">m</label>
<input type="radio" name="al" id="al-ft"><label for="al-ft">ft</label></fieldset>
<fieldset><legend>Temp</legend>
<input type="radio" name="tp" id="tp-c" checked><label for="tp-c">&deg;C</label>
<input type="radio" name="tp" id="tp-f"><label for="tp-f">&deg;F</label></fieldset>
</form>
<p class="muted">Your choices are saved in a cookie in this browser. The cookie holds only these settings.</p>
</div>
</details>
</div>
</header>
<script id="prefs">
// Settings (glider, units) are kept in a first-party cookie, with localStorage as a fallback for
// when cookies are unavailable (for example a page opened from a file). Runs here, straight after
// the settings controls, so the rest of the page is drawn with the saved choices.
(function(){
 var NAME="ffforecast-prefs",LS="ffforecast-units",YEAR=31536000;
 function dir(){return location.pathname.replace(/[^\/]*$/,"")||"/";}
 function fromCookie(){
  var m=document.cookie.match(new RegExp("(?:^|; )"+NAME+"=([^;]*)"));if(!m){return null;}
  var o={};decodeURIComponent(m[1]).split("&").forEach(function(p){var kv=p.split("=");if(kv[0]&&kv[1]){o[kv[0]]=kv[1];}});return o;}
 function fromStorage(){return JSON.parse(localStorage.getItem(LS)||"null");}
 function read(){var o=null;try{o=fromCookie();}catch(x){}if(!o){try{o=fromStorage();}catch(x){}}return o||{};}
 function apply(o){ // only ever tick a radio that exists and belongs to that setting
  for(var k in o){if(Object.prototype.hasOwnProperty.call(o,k)){var el=document.getElementById(o[k]);
   if(el&&el.type==="radio"&&el.name===k){el.checked=true;}}}}
 function write(){
  var inputs=document.querySelectorAll("input[type=radio]"),o={},parts=[];
  for(var i=0;i<inputs.length;i++){if(inputs[i].checked){o[inputs[i].name]=inputs[i].id;parts.push(inputs[i].name+"="+inputs[i].id);}}
  try{document.cookie=NAME+"="+encodeURIComponent(parts.join("&"))+"; Path="+dir()+"; Max-Age="+YEAR+"; SameSite=Lax"+(location.protocol==="https:"?"; Secure":"");}catch(x){}
  try{localStorage.setItem(LS,JSON.stringify(o));}catch(x){}
 }
 function bind(){ // settings further down the page (the station chart period) appear after this script runs
  var inputs=document.querySelectorAll("input[type=radio]");
  for(var i=0;i<inputs.length;i++){if(!inputs[i].__ff){inputs[i].__ff=1;inputs[i].addEventListener("change",write);}}
 }
 function applyAll(){apply(read());bind();}
 window.ffApplyPrefs=applyAll; // the chart loader calls this so it sees the saved period
 applyAll();
 document.addEventListener("DOMContentLoaded",applyAll);
})();
</script>
