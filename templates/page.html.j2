</footer>
</main>
<script id="enhance">
(function(){
var g=Date.parse("{{ generated_iso }}");
if(g&&Date.now()-g>30*3600*1000){var e=document.getElementById("stale");if(e){e.hidden=false;}}
// Tell the stylesheet how tall the pinned header is, so anything scrolled to stops below it.
var st=document.getElementById("sticky");
function setHdr(){if(st){document.documentElement.style.setProperty("--hdr",st.offsetHeight+"px");}}
setHdr();window.addEventListener("resize",setHdr);
if(window.ResizeObserver&&st){new ResizeObserver(setHdr).observe(st);}

// Close the settings menu on an outside tap or Escape (without this it simply stays open until toggled).
var menu=document.getElementById("menu");
if(menu){document.addEventListener("click",function(e){if(menu.open&&!menu.contains(e.target)){menu.open=false;}});
document.addEventListener("keydown",function(e){if(e.key==="Escape"&&menu.open){menu.open=false;var s=menu.querySelector("summary");if(s){s.focus();}}});}

// Clicking a grade opens the Guide at that grade and highlights it. Without this script the
// links still jump to the Guide (the browser opens it when it can).
function chosenGlider(){var h=document.getElementById("gl-hg");return h&&h.checked?"hg":"pg";}
function showGrade(g,gl){
 gl=gl||chosenGlider();
 var d=document.getElementById("guide"),li=document.getElementById("guide-"+(gl==="hg"?"hg-":"")+g);
 if(!d||!li){return;}
 d.open=true;
 var all=d.querySelectorAll("li.hl");for(var i=0;i<all.length;i++){all[i].classList.remove("hl");}
 li.classList.add("hl");
 try{li.scrollIntoView({behavior:"smooth",block:"center"});}catch(x){li.scrollIntoView();}
 li.focus({preventScroll:true});
}
document.addEventListener("click",function(e){
 var a=e.target&&e.target.closest?e.target.closest("a[data-grade]"):null;
 if(!a){return;}
 e.preventDefault();e.stopPropagation(); // do not also expand or collapse the day row
 showGrade(a.getAttribute("data-grade"));
 try{history.replaceState(null,"",a.getAttribute("href"));}catch(x){} // keeps #guide-hg-... for hang gliders
},true);
function fromHash(){
 var m=/^#guide-(hg-)?(ok|good|strong|poor|turbulent|dangerous)$/.exec(location.hash);
 if(!m){return;}
 var hg=document.getElementById("gl-hg");
 if(m[1]&&hg){hg.checked=true;} // a link to the hang glider text means hang glider
 showGrade(m[2],m[1]?"hg":chosenGlider());
}
window.addEventListener("hashchange",fromHash);fromHash();

// Current conditions tile (optional): Open-Meteo model data for the launch, in every unit.
function u(c,t){return '<span class="u '+c+'">'+t+'</span>';}
function spd(k){return u("s-kts",Math.round(k/1.852)+" kts")+u("s-kph",Math.round(k)+" kph");}
function tmp(c){return u("t-c",Math.round(c)+" \u00b0C")+u("t-f",Math.round(c*9/5+32)+" \u00b0F");}
function rn(m){return u("a-m",m.toFixed(1)+" mm/h")+u("a-ft",(m/25.4).toFixed(2)+" in/h");}
var COMPASS=["N","NNE","NE","ENE","E","ESE","SE","SSE","S","SSW","SW","WSW","W","WNW","NW","NNW"];
function wx(c){
 if(c>=95)return["\u26c8\ufe0f","Thunderstorm"];
 if(c>=80)return["\ud83c\udf26\ufe0f","Showers"];
 if(c>=71&&c<=77)return["\ud83c\udf28\ufe0f","Snow"];
 if(c>=61)return["\ud83c\udf27\ufe0f","Rain"];
 if(c>=51)return["\ud83c\udf27\ufe0f","Drizzle"];
 if(c>=45)return["\ud83c\udf2b\ufe0f","Fog"];
 if(c===3)return["\u2601\ufe0f","Overcast"];
 if(c===2)return["\u26c5","Partly cloudy"];
 if(c===1)return["\ud83c\udf24\ufe0f","Mostly clear"];
 return["\u2600\ufe0f","Clear"];}
var TABS={{ tabs_js|tojson }};
function tile(tab){
 var id=tab.id;
 var url="https://api.open-meteo.com/v1/forecast?latitude="+tab.lat+"&longitude="+tab.lon+"&timezone={{ site.timezone|urlencode }}"
  +(tab.elevation_m!==null?"&elevation="+tab.elevation_m:"")
  +"&current=temperature_2m,precipitation,weather_code,wind_speed_10m,wind_gusts_10m,wind_direction_10m,cape&wind_speed_unit=kmh"
  +"&hourly=temperature_2m,precipitation_probability,precipitation,weather_code,wind_speed_10m,wind_gusts_10m,wind_direction_10m&forecast_days=1";
 var ctl=window.AbortController?new AbortController():null;
 var timer=setTimeout(function(){if(ctl){ctl.abort();}},15000);
 fetch(url,ctl?{signal:ctl.signal}:{}).then(function(r){return r.json();}).then(function(d){
  clearTimeout(timer);var c=d.current;if(!c){return;}
  var w=wx(c.weather_code);
  document.getElementById("now-icon-"+id).textContent=w[0];
  document.getElementById("now-text-"+id).textContent=w[1];
  document.getElementById("now-temp-"+id).innerHTML=tmp(c.temperature_2m);
  document.getElementById("now-wind-"+id).innerHTML=COMPASS[Math.round(c.wind_direction_10m/22.5)%16]+" "+spd(c.wind_speed_10m);
  document.getElementById("now-gust-"+id).innerHTML=spd(c.wind_gusts_10m);
  document.getElementById("now-rain-"+id).innerHTML=c.precipitation>=0.05?rn(c.precipitation):"none";
  var H=d.hourly,body=document.getElementById("today-rows-"+id);body.innerHTML="";
  if(H&&H.time){for(var i=0;i<H.time.length;i++){var hr=parseInt(H.time[i].slice(11,13),10);
   if(hr<6||hr>20||hr%2){continue;}
   var tr=document.createElement("tr");
   if(H.time[i]<(c.time||"").slice(0,13)+":00"){tr.className="past";}
   else if(H.time[i].slice(0,13)===(c.time||"").slice(0,13)){tr.className="nowrow";}
   var p=H.precipitation_probability?H.precipitation_probability[i]:null,mm=H.precipitation[i];
   tr.innerHTML="<td>"+H.time[i].slice(11,16)+"</td><td aria-hidden=\"true\">"+wx(H.weather_code[i])[0]+"</td><td>"+tmp(H.temperature_2m[i])+"</td><td>"+(p===null?"":p+"%")+(mm>=0.1?" "+rn(mm):"")+"</td><td>"+COMPASS[Math.round(H.wind_direction_10m[i]/22.5)%16]+" "+spd(H.wind_speed_10m[i])+" ("+spd(H.wind_gusts_10m[i])+")</td>";
   body.appendChild(tr);}}
  var t=(c.time||"").replace("T"," ");
  document.getElementById("now-note-"+id).textContent="Model estimate for "+tab.label+" at "+t+" local time, not a measurement."+(c.cape>=1000?" High storm energy: check the BoM warnings.":"");
  document.getElementById("now").hidden=false;
 }).catch(function(){clearTimeout(timer);});
}
function tiles(){for(var i=0;i<TABS.length;i++){tile(TABS[i]);}}
tiles();setInterval(tiles,10*60*1000);

// Keep the station chart fresh: refresh the visible one every 5 minutes and when the period is changed.
function freshen(){var imgs=document.querySelectorAll("img.history");
 for(var i=0;i<imgs.length;i++){var im=imgs[i];
  if(im.offsetParent!==null){var base=im.getAttribute("data-src");im.src=base+(base.indexOf("?")>-1?"&":"?")+"rand="+Date.now();}}}
if(window.ffApplyPrefs){window.ffApplyPrefs();} // the saved period first, so the right chart is the one loaded
freshen(); // load the chosen period now: no chart is in the page until it is wanted
setInterval(freshen,5*60*1000);
var per=document.querySelectorAll("input[name=st]");
for(var i=0;i<per.length;i++){per[i].addEventListener("change",freshen);}
})();
</script>
</body>
